  "devDependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@iconify/tailwind4": "^1.2.3",
    "@molarmanful/fe-tools": "^0.6.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/load-config": "^0.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "core-js": "^3.50.0",
    "eslint": "^10.12.0",
    "eslint-plugin-better-tailwindcss": "^4.9.0",
    "eslint-plugin-svelte": "^3.23.0",
    "favicons": "^7.3.1",
    "globals": "^17.13.0",
    "sharp": "^0.35.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
